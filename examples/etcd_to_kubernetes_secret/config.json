{
  "source": {
    "type": "etcd",
    "etcd_endpoints": ["http://localhost:2379"],
    "etcd_prefix": "/my-app/"
  },
  "process": {
    "add_prefix": "",
    "add_suffix": "",
    "include_regex": "",
    "exclude_regex": "",
    "include_types": [],
    "exclude_types": []
  },
  "destination": {
    "type": "kubernetes",
    "conflict_strategy": "replace",
    "kube_namespace": "default",
    "kube_secret_name": "my-app-secrets"
  },
  "dry_run": false
}
