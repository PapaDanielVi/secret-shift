{
  "source": {
    "type": "vault",
    "vault_address": "https://vault.example.com",
    "vault_path": "myapp/config",
    "token": "YOUR_VAULT_TOKEN"
    // "vault_mount": "secret" // Optional, defaults to "secret"
  },
  "process": {
    "add_prefix": "",
    "add_suffix": "",
    "include_regex": "",
    "exclude_regex": "",
    "include_types": [],
    "exclude_types": []
  },
  "destination": {
    "type": "gitlab",
    "project_id": "YOUR_PROJECT_ID",
    "token": "YOUR_GITLAB_TOKEN",
    "conflict_strategy": "replace"
    // "url": "https://gitlab.mycompany.com" // Optional: for self-hosted GitLab
  },
  "dry_run": false
}
